rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'cherrysanjana2601@gmail.com' ||
        request.auth.token.email == 'dingarimanogna12@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Entity 1: Doctor Profile Validation
    function isValidDoctorProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'entityType', 'role', 'organization']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'entityType', 'role', 'organization', 'licenseNumber', 'createdAt']) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.displayName is string && data.displayName.size() <= 100 &&
        data.entityType == 'doctor' &&
        data.role is string && data.role.size() <= 60 &&
        data.organization is string && data.organization.size() <= 120 &&
        (data.email == null || (data.email is string && data.email.size() <= 120)) &&
        (!('licenseNumber' in data) || (data.licenseNumber is string && data.licenseNumber.size() <= 60)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    // Entity 2: Patient Profile Validation
    function isValidPatientProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'entityType', 'role']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'entityType', 'role', 'organization', 'ageYears', 'gender', 'allergies', 'createdAt']) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.displayName is string && data.displayName.size() <= 100 &&
        data.entityType == 'patient' &&
        data.role is string && data.role.size() <= 60 &&
        (data.email == null || (data.email is string && data.email.size() <= 120)) &&
        (!('organization' in data) || (data.organization is string && data.organization.size() <= 120)) &&
        (!('ageYears' in data) || (data.ageYears is number && data.ageYears >= 0 && data.ageYears <= 150)) &&
        (!('gender' in data) || (data.gender in ['Male', 'Female', 'Other', 'Unknown'])) &&
        (!('allergies' in data) || (data.allergies is string && data.allergies.size() <= 200)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    // Unified User Profile (backward compatibility)
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName']) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.displayName is string && data.displayName.size() <= 100 &&
        (data.email == null || (data.email is string && data.email.size() <= 120));
    }

    function isValidPrescriptionRecord(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'timestamp', 'diagnosis', 'overallStatus']) &&
        data.keys().hasOnly(['id', 'userId', 'timestamp', 'diagnosis', 'species', 'patientType', 'overallStatus', 'rawText', 'analysisData']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId == userId &&
        data.timestamp is string && data.timestamp.size() <= 50 &&
        data.diagnosis is string && data.diagnosis.size() <= 200 &&
        data.overallStatus in ['CRITICAL', 'WARNING', 'INFO', 'COMPLIANT'] &&
        (!('species' in data) || (data.species is string && data.species.size() <= 50)) &&
        (!('patientType' in data) || (data.patientType in ['human', 'veterinary'])) &&
        (!('rawText' in data) || (data.rawText is string && data.rawText.size() <= 5000)) &&
        (!('analysisData' in data) || (data.analysisData is string && data.analysisData.size() <= 250000));
    }

    // ==========================================
    // ENTITY 1: Doctors (/doctors/{doctorId})
    // ==========================================
    match /doctors/{doctorId} {
      allow get: if isValidId(doctorId) && (isOwner(doctorId) || isAdmin());
      allow list: if isSignedIn();
      allow create: if isValidId(doctorId) && isOwner(doctorId) && isValidDoctorProfile(request.resource.data) && request.resource.data.uid == request.auth.uid;
      allow update: if isValidId(doctorId) && isOwner(doctorId) && isValidDoctorProfile(request.resource.data) && request.resource.data.uid == request.auth.uid;
      allow delete: if isValidId(doctorId) && (isOwner(doctorId) || isAdmin());

      match /prescriptions/{prescriptionId} {
        allow get: if isValidId(doctorId) && isValidId(prescriptionId) && (isOwner(doctorId) || isAdmin());
        allow delete: if isValidId(doctorId) && isValidId(prescriptionId) && (isOwner(doctorId) || isAdmin());
        allow list: if isValidId(doctorId) && (isOwner(doctorId) || isAdmin());
        allow create: if isValidId(doctorId) && isValidId(prescriptionId) && isOwner(doctorId) &&
          isValidPrescriptionRecord(request.resource.data, doctorId) &&
          request.resource.data.userId == request.auth.uid;
        allow update: if isValidId(doctorId) && isValidId(prescriptionId) && isOwner(doctorId) &&
          isValidPrescriptionRecord(request.resource.data, doctorId) &&
          request.resource.data.userId == request.auth.uid;
      }
    }

    // ==========================================
    // ENTITY 2: Patients (/patients/{patientId})
    // ==========================================
    match /patients/{patientId} {
      allow get: if isValidId(patientId) && (isOwner(patientId) || isAdmin());
      allow list: if isSignedIn();
      allow create: if isValidId(patientId) && isOwner(patientId) && isValidPatientProfile(request.resource.data) && request.resource.data.uid == request.auth.uid;
      allow update: if isValidId(patientId) && isOwner(patientId) && isValidPatientProfile(request.resource.data) && request.resource.data.uid == request.auth.uid;
      allow delete: if isValidId(patientId) && (isOwner(patientId) || isAdmin());

      match /prescriptions/{prescriptionId} {
        allow get: if isValidId(patientId) && isValidId(prescriptionId) && (isOwner(patientId) || isAdmin());
        allow delete: if isValidId(patientId) && isValidId(prescriptionId) && (isOwner(patientId) || isAdmin());
        allow list: if isValidId(patientId) && (isOwner(patientId) || isAdmin());
        allow create: if isValidId(patientId) && isValidId(prescriptionId) && isOwner(patientId) &&
          isValidPrescriptionRecord(request.resource.data, patientId) &&
          request.resource.data.userId == request.auth.uid;
        allow update: if isValidId(patientId) && isValidId(prescriptionId) && isOwner(patientId) &&
          isValidPrescriptionRecord(request.resource.data, patientId) &&
          request.resource.data.userId == request.auth.uid;
      }
    }

    // ==========================================
    // Legacy / Unified Users (/users/{userId})
    // ==========================================
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn();
      allow create: if isValidId(userId) && isOwner(userId) && isValidUserProfile(request.resource.data) && request.resource.data.uid == request.auth.uid;
      allow update: if isValidId(userId) && isOwner(userId) && isValidUserProfile(request.resource.data) && request.resource.data.uid == request.auth.uid;
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());

      match /prescriptions/{prescriptionId} {
        allow get: if isValidId(userId) && isValidId(prescriptionId) && (isOwner(userId) || isAdmin());
        allow delete: if isValidId(userId) && isValidId(prescriptionId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin());
        allow create: if isValidId(userId) && isValidId(prescriptionId) && isOwner(userId) &&
          isValidPrescriptionRecord(request.resource.data, userId) &&
          request.resource.data.userId == request.auth.uid;
        allow update: if isValidId(userId) && isValidId(prescriptionId) && isOwner(userId) &&
          isValidPrescriptionRecord(request.resource.data, userId) &&
          request.resource.data.userId == request.auth.uid;
      }
    }
  }
}
